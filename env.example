GEMINI_API_KEY=
# GEMINI_SEARCH_MODEL=
# GEMINI_EXTRACT_MODEL=

# Входящий вебхук Bitrix24, например https://portal.bitrix24.kz/rest/1/xxxxxxxx/
# Права вебхука: CRM (crm). Для автосоздания источника «ИИ-поиск» нужны права администратора CRM.
BITRIX_WEBHOOK_URL=

# Стадия лида: код первой стадии воронки лидов («Неразобранное»). По умолчанию NEW.
# BITRIX_LEAD_STATUS=NEW
# Если источник «ИИ-поиск» уже создан в CRM - его код:
# BITRIX_SOURCE_ID=
# Пользовательское поле лида под БИН (если создано):
# BITRIX_BIN_FIELD=UF_CRM_BIN
# Поле БИН в реквизитах компаний (для поиска дублей среди компаний CRM):
# BITRIX_REQUISITE_BIN_FIELD=
# Ответственный за новые лиды:
# BITRIX_ASSIGNED_BY_ID=
